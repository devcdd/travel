{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "description": "content/countries/<코드>.yaml의 코드"
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "description": "상단 작은 경로 표기 (예: ICN → TPE)"
    },
    "start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "hotel": {
      "type": "object",
      "properties": {
        "place": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
          "description": "places.yaml에 정의한 장소 id"
        },
        "access": {
          "type": "string",
          "minLength": 1
        },
        "nights": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "place",
        "access",
        "nights"
      ],
      "additionalProperties": false
    },
    "info": {
      "default": [],
      "description": "이 여행에만 해당하는 현지 정보. 나라 정보보다 먼저 보여요",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "description": "묶음 이름. 같은 묶음끼리 모아서 보여요 (없으면 \"기타\")",
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "description": "짧은 설명 문장",
            "type": "string",
            "minLength": 1
          },
          "points": {
            "description": "하나씩 끊어 볼 내용. 항목마다 한 문장씩",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    "apps": {
      "default": [],
      "description": "나라 공통 앱 목록 뒤에 더할 앱",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "store": {
            "description": "이름 옆에 작게 보일 설명",
            "type": "string",
            "minLength": 1
          },
          "desc": {
            "type": "string",
            "minLength": 1
          },
          "must": {
            "type": "boolean"
          },
          "ios": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "web": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "group",
          "name",
          "desc"
        ],
        "additionalProperties": false
      }
    },
    "flights": {
      "default": [],
      "description": "항공편. 있으면 \"항공·숙소\" 탭이 생겨요. 예약번호는 적지 마세요",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "가는 편, 오는 편처럼 짧게"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "airline": {
            "type": "string",
            "minLength": 1
          },
          "flight": {
            "type": "string",
            "minLength": 1,
            "description": "편명 (예: KE2085)"
          },
          "from": {
            "type": "object",
            "properties": {
              "airport": {
                "type": "string",
                "minLength": 1,
                "description": "공항 이름 (예: 부산 김해)"
              },
              "time": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$",
                "description": "현지 시각"
              },
              "terminal": {
                "description": "터미널 (예: 1터미널)",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "airport",
              "time"
            ],
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "properties": {
              "airport": {
                "type": "string",
                "minLength": 1,
                "description": "공항 이름 (예: 부산 김해)"
              },
              "time": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$",
                "description": "현지 시각"
              },
              "terminal": {
                "description": "터미널 (예: 1터미널)",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "airport",
              "time"
            ],
            "additionalProperties": false
          },
          "duration": {
            "description": "비행 시간 (예: 2시간 30분)",
            "type": "string",
            "minLength": 1
          },
          "tips": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "label",
          "date",
          "airline",
          "flight",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "stay": {
      "default": [],
      "description": "숙소 예약 정보 (체크인 시간, 조식 등). \"항공·숙소\" 탭에 숙소와 함께 보여요",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "country",
    "city",
    "route",
    "start",
    "end",
    "summary",
    "hotel"
  ],
  "additionalProperties": false
}
