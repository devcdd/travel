{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "description": "content/countries/<코드>.yaml의 코드"
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "description": "상단 작은 경로 표기 (예: ICN → TPE)"
    },
    "start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "hotel": {
      "type": "object",
      "properties": {
        "place": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
          "description": "places.yaml에 정의한 장소 id"
        },
        "access": {
          "type": "string",
          "minLength": 1
        },
        "nights": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "place",
        "access",
        "nights"
      ],
      "additionalProperties": false
    },
    "info": {
      "default": [],
      "description": "이 여행에만 해당하는 현지 정보. 나라 정보보다 먼저 보여요",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "apps": {
      "default": [],
      "description": "나라 공통 앱 목록 뒤에 더할 앱",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "store": {
            "description": "이름 옆에 작게 보일 설명",
            "type": "string",
            "minLength": 1
          },
          "desc": {
            "type": "string",
            "minLength": 1
          },
          "must": {
            "type": "boolean"
          },
          "ios": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "web": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "group",
          "name",
          "desc"
        ],
        "additionalProperties": false
      }
    },
    "footer": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "title",
    "country",
    "city",
    "route",
    "start",
    "end",
    "summary",
    "hotel",
    "footer"
  ],
  "additionalProperties": false
}
