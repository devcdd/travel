{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
    "description": "places.yaml에 정의한 장소 id"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "한국어 이름"
      },
      "local": {
        "type": "string",
        "minLength": 1,
        "description": "현지어 이름. 택시 카드에 크게 표시돼요"
      },
      "q": {
        "type": "string",
        "minLength": 1,
        "description": "Google 지도 검색어"
      },
      "lat": {
        "type": "number"
      },
      "lng": {
        "type": "number"
      },
      "address": {
        "description": "현지어 주소. 택시 카드와 주소 복사에 쓰여요",
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "name",
      "local",
      "q"
    ],
    "additionalProperties": false
  }
}
