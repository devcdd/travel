{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA 시간대 (예: Asia/Taipei)"
    },
    "lang": {
      "type": "string",
      "minLength": 1,
      "description": "현지어 BCP 47 코드 (예: zh-TW). 현지어 글꼴 선택에 쓰여요"
    },
    "currency": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "quick": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "required": [
        "code",
        "symbol",
        "quick"
      ],
      "additionalProperties": false
    },
    "taxi": {
      "type": "object",
      "properties": {
        "ask": {
          "type": "string",
          "minLength": 1,
          "description": "택시 카드 위에 보일 \"여기로 가 주세요\" 현지어 문장"
        }
      },
      "required": [
        "ask"
      ],
      "additionalProperties": false
    },
    "lines": {
      "default": {},
      "description": "{BL10}처럼 본문에 쓰는 노선 코드와 색",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "text": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "required": [
          "name",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "info": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "emergency": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "number"
        ],
        "additionalProperties": false
      }
    },
    "apps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "store": {
            "description": "이름 옆에 작게 보일 설명",
            "type": "string",
            "minLength": 1
          },
          "desc": {
            "type": "string",
            "minLength": 1
          },
          "must": {
            "type": "boolean"
          },
          "ios": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "web": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "group",
          "name",
          "desc"
        ],
        "additionalProperties": false
      }
    },
    "checklist": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "체크 상태 저장 키. 한번 정하면 바꾸지 마세요"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "desc": {
            "type": "string",
            "minLength": 1
          },
          "due": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "desc",
          "due"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "timeZone",
    "lang",
    "currency",
    "taxi"
  ],
  "additionalProperties": false
}
