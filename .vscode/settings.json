    "./content/.schema/country.json": "content/countries/*.yaml",
    "./content/.schema/trip.json": "content/trips/*/trip.yaml",
    "./content/.schema/places.json": "content/trips/*/places.yaml",
    "./content/.schema/day.json": "content/trips/*/days/*.yaml",
